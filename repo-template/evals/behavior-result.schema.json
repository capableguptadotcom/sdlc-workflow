{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "visible_modes",
    "route",
    "questions_asked",
    "human_gates",
    "commands_run",
    "terminal_state",
    "summary"
  ],
  "properties": {
    "scenario_id": {
      "type": "string"
    },
    "visible_modes": {
      "description": "AI-SDLC workflow semantic labels observed during the turn, not Codex UI or message channels.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "inspect",
          "shape",
          "plan",
          "implement",
          "diagnose",
          "initiative",
          "finish",
          "learn",
          "update"
        ]
      }
    },
    "route": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions_asked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "terminal_state": {
      "description": "The AI-SDLC semantic outcome of the turn, not a Codex UI completion status.",
      "type": "string",
      "enum": [
        "ready",
        "adopted",
        "accepted-decision",
        "mapped",
        "diagnosed",
        "needs-human-decision",
        "awaiting_product_decision",
        "awaiting-spec-acceptance",
        "committed",
        "resumed",
        "conflict"
      ]
    },
    "summary": {
      "type": "string"
    }
  }
}
